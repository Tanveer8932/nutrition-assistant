{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://RAILWAY_BACKEND_URL/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
