# Provider: openai (default), groq, or anthropic
LLM_PROVIDER=openai

# LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano-2025-08-07
OPENAI_REASONING_EFFORT=minimal

# LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional: low | medium | high (unset = Groq default)
GROQ_REASONING_EFFORT=

# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low

# Point at a Railway volume mount so conversations survive redeploys, e.g. /data/nutrition.db
DB_PATH=
# Only needed if the frontend calls the backend directly instead of via the Vercel rewrite
CORS_ORIGINS=http://localhost:4200
