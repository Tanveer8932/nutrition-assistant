ANTHROPIC_API_KEY=sk-ant-...
# Optional
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low
# Point at a Railway volume mount so conversations survive redeploys, e.g. /data/nutrition.db
DB_PATH=
# Only needed if the frontend calls the backend directly instead of via the Vercel rewrite
CORS_ORIGINS=http://localhost:4200
